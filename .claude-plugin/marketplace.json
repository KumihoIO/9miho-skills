{
  "name": "miho",
  "owner": {
    "name": "Kumiho",
    "url": "https://kumiho.io"
  },
  "plugins": [
    {
      "name": "miho",
      "source": "./",
      "description": "Drive 9miho from your agent: compose and run image/video flows whose outputs land in a library with provenance. Guidance is served by your own 9miho over MCP, so it always matches the server you are talking to.",
      "version": "0.2.0",
      "skills": [
        {
          "name": "generate",
          "path": "miho-generate",
          "invoke": "/miho:generate"
        },
        {
          "name": "library",
          "path": "miho-library",
          "invoke": "/miho:library"
        },
        {
          "name": "photoshoot",
          "path": "miho-photoshoot",
          "invoke": "/miho:photoshoot"
        },
        {
          "name": "storyboard",
          "path": "miho-storyboard",
          "invoke": "/miho:storyboard"
        },
        {
          "name": "subject",
          "path": "miho-subject",
          "invoke": "/miho:subject"
        }
      ]
    }
  ]
}
